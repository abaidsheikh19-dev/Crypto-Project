generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                  Int      @id @default(autoincrement())
  slug                String   @unique
  sku                 String   @unique
  name                String
  description         String
  priceCents          Int      @map("price_cents")
  stockQty            Int      @default(0) @map("stock_qty")
  lowStockThreshold   Int      @default(5) @map("low_stock_threshold")
  isActive            Boolean  @default(true) @map("is_active")
  isRestricted        Boolean  @default(false) @map("is_restricted")
  sortOrder           Int      @default(0) @map("sort_order")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  productImages       ProductImage[]
  cartItems           CartItem[]
  orderItems          OrderItem[]
  promotions          Promotion[]
  stockAdjustments    StockAdjustment[]

  @@map("products")
}

model ProductImage {
  id         Int      @id @default(autoincrement())
  productId  Int      @map("product_id")
  fileKey    String   @map("file_key")
  altText    String?  @map("alt_text")
  sortOrder  Int      @default(0) @map("sort_order")
  product    Product  @relation(fields: [productId], references: [id])

  @@map("product_images")
}

model Promotion {
  id         Int      @id @default(autoincrement())
  productId  Int      @map("product_id")
  type       String
  value      Int
  startsAt   DateTime? @map("starts_at")
  endsAt     DateTime? @map("ends_at")
  isActive   Boolean  @default(true) @map("is_active")
  product    Product  @relation(fields: [productId], references: [id])

  @@map("promotions")
}

model DiscountCode {
  id             Int       @id @default(autoincrement())
  codeNormalized String    @unique @map("code_normalized")
  type           String
  value          Int
  minOrderCents  Int?      @map("min_order_cents")
  maxUses        Int?      @map("max_uses")
  usedCount      Int       @default(0) @map("used_count")
  expiresAt      DateTime? @map("expires_at")
  isActive       Boolean   @default(true) @map("is_active")
  orders         Order[]

  @@map("discount_codes")
}

model Cart {
  id           Int        @id @default(autoincrement())
  tokenHash    String     @unique @map("token_hash")
  customerId   Int?       @map("customer_id")
  discountCodeId Int?     @map("discount_code_id")
  expiresAt    DateTime   @map("expires_at")
  items        CartItem[]

  @@map("carts")
}

model CartItem {
  id         Int     @id @default(autoincrement())
  cartId     Int     @map("cart_id")
  productId  Int     @map("product_id")
  qty        Int
  cart       Cart    @relation(fields: [cartId], references: [id])
  product    Product @relation(fields: [productId], references: [id])

  @@map("cart_items")
}

model Customer {
  id           Int      @id @default(autoincrement())
  emailEnc     String   @map("email_enc")
  emailHmac    String   @unique @map("email_hmac")
  passwordHash String   @map("password_hash")
  nameEnc      String?  @map("name_enc")
  lastActiveAt DateTime? @map("last_active_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("customers")
}

model Order {
  id                Int          @id @default(autoincrement())
  publicTokenHash   String       @unique @map("public_token_hash")
  customerId        Int?         @map("customer_id")
  status            String
  subtotalCents     Int          @map("subtotal_cents")
  discountCents     Int          @map("discount_cents")
  shippingCents     Int          @map("shipping_cents")
  totalCents        Int          @map("total_cents")
  discountCodeId    Int?         @map("discount_code_id")
  emailEnc          String?      @map("email_enc")
  nameEnc           String?      @map("name_enc")
  addressLine1Enc   String?      @map("address_line1_enc")
  addressLine2Enc   String?      @map("address_line2_enc")
  cityEnc           String?      @map("city_enc")
  regionEnc         String?      @map("region_enc")
  postcodeEnc       String?      @map("postcode_enc")
  countryEnc        String?      @map("country_enc")
  piiPurgedAt       DateTime?    @map("pii_purged_at")
  trackingNumber    String?      @map("tracking_number")
  btcpayInvoiceId   String?      @map("btcpay_invoice_id")
  paidAt            DateTime?    @map("paid_at")
  shippedAt         DateTime?    @map("shipped_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  items             OrderItem[]
  discountCode      DiscountCode? @relation(fields: [discountCodeId], references: [id])

  @@map("orders")
}

model OrderItem {
  id            Int     @id @default(autoincrement())
  orderId       Int     @map("order_id")
  productId     Int?    @map("product_id")
  productNameSnapshot String @map("product_name_snapshot")
  unitPriceCents Int     @map("unit_price_cents")
  qty           Int
  order         Order   @relation(fields: [orderId], references: [id])
  product       Product? @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model StockAdjustment {
  id          Int      @id @default(autoincrement())
  productId   Int      @map("product_id")
  delta       Int
  reason      String
  adminUserId Int?     @map("admin_user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  product     Product  @relation(fields: [productId], references: [id])

  @@map("stock_adjustments")
}

model StockReservation {
  id         Int      @id @default(autoincrement())
  orderId    Int      @map("order_id")
  productId  Int      @map("product_id")
  qty        Int
  expiresAt  DateTime @map("expires_at")

  @@map("stock_reservations")
}

model WebhookEvent {
  id         Int      @id @default(autoincrement())
  provider   String
  eventId    String   @unique @map("event_id")
  receivedAt DateTime @default(now()) @map("received_at")

  @@map("webhook_events")
}

model Setting {
  key       String   @id
  value     String
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Session {
  idHash      String   @id @map("id_hash")
  subjectType String   @map("subject_type")
  subjectId   Int      @map("subject_id")
  createdAt   DateTime @default(now()) @map("created_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  expiresAt   DateTime @map("expires_at")

  @@map("sessions")
}

model PasswordResetToken {
  tokenHash  String   @id @map("token_hash")
  subjectType String   @map("subject_type")
  subjectId   Int      @map("subject_id")
  expiresAt   DateTime @map("expires_at")
  usedAt     DateTime? @map("used_at")

  @@map("password_reset_tokens")
}

model AdminUser {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  passwordHash       String   @map("password_hash")
  role               String
  totpSecretEnc      String?  @map("totp_secret_enc")
  recoveryCodesHash  String[] @map("recovery_codes_hash")
  isActive           Boolean  @default(true) @map("is_active")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorType  String?  @map("actor_type")
  actorId    Int?     @map("actor_id")
  action     String
  targetType String?  @map("target_type")
  targetId   Int?     @map("target_id")
  metadataJson String? @map("metadata_json")
  ipHash     String?  @map("ip_hash")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
