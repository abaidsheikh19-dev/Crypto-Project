# Copy to .env for local development. Never commit real values.
# `npm run gen:secrets` prints fresh random values for the secrets below.

# --- Required ---------------------------------------------------------------
# Postgres. On Vercel, connecting a Neon database sets both of these for you.
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/store
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:54329/store
# 32 random bytes, base64. Encrypts all personal data. Back it up safely.
APP_MASTER_KEY=
# First Owner admin, created by the seed only when no admin exists yet.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=

# --- Optional ---------------------------------------------------------------
# Public URL for links in emails (defaults to the Vercel URL or localhost).
APP_URL=
CONTACT_EMAIL=orders@example.com
# Vercel Cron sends this as a Bearer token to /api/cron/daily.
CRON_SECRET=
# Only while rotating APP_MASTER_KEY (see docs/operations.md).
APP_MASTER_KEY_PREVIOUS=

# Payments: leave blank for demo mode (simulated invoices).
PAYMENTS_MODE=
BTCPAY_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=

# Email: leave blank to capture emails in Admin -> Emails instead of sending.
RESEND_API_KEY=
EMAIL_FROM=
